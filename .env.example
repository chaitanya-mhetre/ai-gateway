# Copy to .env and fill in. Never commit .env.
GATEWAY_CONFIG_PATH=config/gateway.yaml
GATEWAY_REDIS_URL=redis://localhost:56382/0
GATEWAY_DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:55435/gateway
# Pepper for hashing API keys and admin tokens. Changing it invalidates every existing key/token.
GATEWAY_KEY_PEPPER=change-me-long-random-string
GATEWAY_AUTH_ENABLED=true
GATEWAY_OTEL_ENABLED=false
# Run migrations on startup (dev). In production run `ai-gateway migrate` as a release step instead.
GATEWAY_AUTO_MIGRATE=true
# Admins are users with roles, not an env var: `ai-gateway create-admin --email you@example.com --role owner`
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Provider credentials (only the ones referenced by api_key_env in your config)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
